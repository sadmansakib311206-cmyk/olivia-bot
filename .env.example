PORT=3000
# Meta webhook verify token — তুমি নিজে বানাবে (যেকোনো গোপন লেখা), Meta-তে এই মানটাই বসাবে
VERIFY_TOKEN=amar-gopon-token-123
# Facebook Page access token — Meta developer app থেকে নেবে (কখনো কাউকে দেবে না, কোডে বসাবে না)
PAGE_ACCESS_TOKEN=
# তোমার নিজের ফ্রি Gemini API key (Google AI Studio থেকে)
GEMINI_API_KEY=
# Meta app secret — webhook signature যাচাইয়ের জন্য (ঐচ্ছিক; না দিলে যাচাই ছাড়া চলবে)
APP_SECRET=
# Facebook Page ID — পোস্ট পাবলিশের জন্য (পেজের About/সেটিংসে পাওয়া যায়; না দিলে 'me' ব্যবহার হবে)
PAGE_ID=
# 1 করলে Graph API-তে আসল মেসেজ পাঠাবে না, শুধু outbox.json-এ লিখবে (লোকাল টেস্টের জন্য)
TEST_MODE=0
# ---- অটো পোস্ট ----
# 0 করলে শিডিউলার বন্ধ থাকবে (তবে /post-now দিয়ে হাতে পোস্ট করানো যাবে)
POST_ENABLED=1
# দিনে কয়টি পোস্ট (POST_TIMES-এর প্রথম এতটি সময় ব্যবহার হবে)
POSTS_PER_DAY=5
# পোস্টের সময় (ঢাকা সময়, HH:MM, কমা দিয়ে আলাদা) — ডিফল্ট: সকাল, দুপুর, সন্ধ্যা
POST_TIMES=08:00,11:00,14:00,17:00,20:00
# /post-now ডাকার গোপন টোকেন — বসানো থাকলে ?token=... মিলতেই হবে (বাইরের cron-এ বসাবে)
POST_NOW_TOKEN=
